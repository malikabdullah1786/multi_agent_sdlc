# ==========================================
# Multi-Agent SDLC - Environment Variables
# ==========================================

# ------------------------------------------
# 1. LLM Configuration (Required)
# ------------------------------------------
# Choose provider: 'groq' (default cloud) or 'ollama' (local)
LLM_PROVIDER=groq

# Model name:
# For Groq: llama-3.1-70b-versatile, llama-3.3-70b-versatile, etc.
# For Ollama: llama3.2, mistral, etc.
LLM_MODEL=llama-3.1-70b-versatile

# Groq API Key (Required if LLM_PROVIDER=groq)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional, if using OpenAI)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama Settings (Optional, used only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384

# ------------------------------------------
# 2. GitHub Integration (Required for PRs)
# ------------------------------------------
# GitHub Personal Access Token (classic token with 'repo' scope, or fine-grained)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username

# ------------------------------------------
# 3. PostgreSQL Database (Required for Backend & DB Agent)
# ------------------------------------------
# FastAPI Backend Async Connection String
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agenticdb

# Database Engineer Agent Direct Connection Details
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------
# 4. Jira Integration (Optional - falls back to stubs if missing)
# ------------------------------------------
# Generate API Token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=KAN

# ------------------------------------------
# 5. Slack Integration (Optional - falls back if missing)
# ------------------------------------------
# Create an App at: https://api.slack.com/apps with chat:write & channels:manage scopes
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ------------------------------------------
# 6. Observability & Tracing (Optional)
# ------------------------------------------
# LangSmith tracing for LangGraph debugging: https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

